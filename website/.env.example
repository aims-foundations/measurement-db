# Browser-visible by design. Use a key with only the `search` action, scoped to
# measurement_db_benchmarks and measurement_db_results.
NEXT_PUBLIC_MEILISEARCH_HOST=https://your-project-url.meilisearch.io
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=your-search-only-key

# Used only by `pnpm search:sync` or CI. Never add this value to a
# NEXT_PUBLIC_* variable or expose it through the website bundle.
MEILISEARCH_HOST=https://your-project-url.meilisearch.io
MEILISEARCH_ADMIN_KEY=your-admin-or-sync-key

# Build-only, optional for HF authentication/rate limits. Never use NEXT_PUBLIC_.
HF_TOKEN=
# Pin one public dataset revision for rendering and analyses; omit to use current.
HF_REVISION=
